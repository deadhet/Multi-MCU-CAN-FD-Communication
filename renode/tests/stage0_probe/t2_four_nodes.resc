emulation CreateCANHub "canHub"
mach create "mcu1"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus.usart1 CreateFileBackend $ORIGIN/out/mcu1.log true
connector Connect sysbus.fdcan1 canHub
macro reset
"""
    sysbus LoadELF $ORIGIN/build/probe1.elf
"""
runMacro $reset
mach create "mcu2"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus.usart1 CreateFileBackend $ORIGIN/out/mcu2.log true
connector Connect sysbus.fdcan1 canHub
macro reset
"""
    sysbus LoadELF $ORIGIN/build/probe2.elf
"""
runMacro $reset
mach create "mcu3"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus.usart1 CreateFileBackend $ORIGIN/out/mcu3.log true
connector Connect sysbus.fdcan1 canHub
macro reset
"""
    sysbus LoadELF $ORIGIN/build/probe3.elf
"""
runMacro $reset
mach create "mcu4"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus.usart1 CreateFileBackend $ORIGIN/out/mcu4.log true
connector Connect sysbus.fdcan1 canHub
sysbus LoadELF $ORIGIN/build/probe4.elf
mach set "mcu1"
emulation CreateServerSocketTerminal 3456 "uartTerm" false
connector Connect sysbus.usart3 uartTerm
emulation SetGlobalQuantum "0.0001"
echo "### CHK quantum"
emulation GetTimeSourceInfo
echo "### A normal 0-1.0"
emulation RunFor "1"
echo "### B halt mcu3 1.0-1.5"
mach set "mcu3"
sysbus.cpu IsHalted true
emulation RunFor "0.5"
echo "### mcu3 RXF0S while halted"
sysbus ReadDoubleWord 0x4000A0A4
echo "### C unhalt mcu3 1.5-2.0"
sysbus.cpu IsHalted false
emulation RunFor "0.5"
echo "### D disconnect mcu3 2.0-2.3"
connector Disconnect sysbus.fdcan1 canHub
emulation RunFor "0.3"
echo "### mcu3 TXBRP / TXFQS while disconnected"
sysbus ReadDoubleWord 0x4000A0CC
sysbus ReadDoubleWord 0x4000A0C4
echo "### E reconnect mcu3 2.3-2.6"
connector Connect sysbus.fdcan1 canHub
emulation RunFor "0.3"
echo "### mcu3 TXBRP / TXFQS after reconnect"
sysbus ReadDoubleWord 0x4000A0CC
sysbus ReadDoubleWord 0x4000A0C4
echo "### F log peripheral access mcu2 for 20 ms"
mach set "mcu2"
sysbus LogPeripheralAccess sysbus.fdcan1 true
emulation RunFor "0.02"
sysbus LogPeripheralAccess sysbus.fdcan1 false
echo "### G halt mcu3 then Reset while halted (macro), mcu4 Reset without macro"
mach set "mcu3"
sysbus WriteDoubleWord 0x2001F000 0xCAFEF00D
sysbus WriteDoubleWord 0x4000AF00 0xCAFEF00D
sysbus WriteDoubleWord 0x24000000 0xCAFEF00D
sysbus.cpu IsHalted true
emulation RunFor "0.2"
machine Reset
echo "### mcu3 after reset: halted? DTCM magic, msgRAM magic, AXI magic, CCCR, RXF0S"
sysbus.cpu IsHalted
sysbus ReadDoubleWord 0x2001F000
sysbus ReadDoubleWord 0x4000AF00
sysbus ReadDoubleWord 0x24000000
sysbus ReadDoubleWord 0x4000A018
sysbus ReadDoubleWord 0x4000A0A4
mach set "mcu4"
machine Reset
echo "### mcu4 after reset without macro: flash word 0, PC"
sysbus ReadDoubleWord 0x08000000
sysbus.cpu PC
echo "### H run 0.5 after resets"
emulation RunFor "0.5"
mach set "mcu3"
echo "### mcu3 halted, PC"
sysbus.cpu IsHalted
sysbus.cpu PC
echo "### mcu4 PC"
mach set "mcu4"
sysbus.cpu PC
emulation GetTimeSourceInfo
quit
