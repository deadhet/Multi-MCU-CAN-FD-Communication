# MCU3 off the bus from 1.5 s to 2.5 s, back on, and reset 3 ms later. Its Tx FIFO still holds
# frames from 1.5 s, including a heartbeat that says OPERATIONAL; they go out first at
# reconnect, then the reset clears MCU3 and its boot heartbeat says BOOT. Peers must count one
# restart, stay RECOVERING, and go ONLINE only on MCU3's later OPERATIONAL heartbeat.
#   renode --disable-gui --console -e "include @renode/tests/stage6_old_hb_then_boot.resc" </dev/null
include $ORIGIN/../system.resc
emulation RunFor "1.5"
mach set "mcu3"
connector Disconnect sysbus.fdcan1 canHub
emulation RunFor "1.0"
connector Connect sysbus.fdcan1 canHub
emulation RunFor "0.003"
mach set "mcu3"
machine Reset
emulation RunFor "1.0"
quit
