# Stage 2 step 1 check. Run from anywhere:
#   renode --disable-gui --console -e "include @renode/stage2_clock_check.resc" </dev/null
mach create "m"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus LoadELF $ORIGIN/../build/node1.elf
emulation RunFor "0.01"
echo "### Core clock. Start 0x03D09000 (64 MHz), goal 0x1C9C3800 (480 MHz)"
sysbus.nvic Frequency
echo "### RCC_CFGR. Start 0x00000000, goal 0x0000001B"
sysbus ReadDoubleWord 0x58024410
echo "### RCC_CR. Goal has bits 24-27 set: PLL1 and PLL2 on and ready"
sysbus ReadDoubleWord 0x58024400
echo "### FLASH_ACR. Goal 0x00000024"
sysbus ReadDoubleWord 0x52002000
echo "### Step C: RCC_PLLCKSELR. Start 0x02020200, goal 0x02004040"
sysbus ReadDoubleWord 0x58024428
echo "### Step E: RCC_PLL1DIVR. Start 0x01010280, goal 0x0000023B"
sysbus ReadDoubleWord 0x58024430
echo "### Step E: RCC_PLL2DIVR. Start 0x01010280, goal 0x00030013"
sysbus ReadDoubleWord 0x58024438
echo "### Step F: RCC_D1CFGR. Start 0x00000000, goal 0x00000048"
sysbus ReadDoubleWord 0x58024418
echo "### Step F: RCC_D2CFGR. Start 0x00000000, goal 0x00000440"
sysbus ReadDoubleWord 0x5802441C
echo "### Step F: RCC_D3CFGR. Start 0x00000000, goal 0x00000040"
sysbus ReadDoubleWord 0x58024420
echo "### PC. Must be main, not Default_Handler"
sysbus.cpu PC
quit
