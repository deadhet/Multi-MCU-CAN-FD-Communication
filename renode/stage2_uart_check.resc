# Stage 2 step 3 check. First run: mkdir -p logs
#   renode --disable-gui --console -e "include @renode/stage2_uart_check.resc" </dev/null
# Output goes to logs/uart_check.log. An older file is kept as uart_check.log.1 and so on.
mach create "m"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl
sysbus.usart1 CreateFileBackend $ORIGIN/../logs/uart_check.log true
sysbus LoadELF $ORIGIN/../build/node1.elf
emulation RunFor "0.01"
echo "### USART1_BRR. Goal 0x00000412 = 1042"
sysbus ReadDoubleWord 0x4001100C
echo "### USART1_CR1. Goal 0x00000009: TE and UE on, TXEIE off again after sending"
sysbus ReadDoubleWord 0x40011000
echo "### PC. Must be main, not Default_Handler"
sysbus.cpu PC
quit
